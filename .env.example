# 本機開發：執行 pnpm env:local，會從 supabase status 自動產生 .env.local（Next.js 會自動讀取）。
# 只有要連其他資料庫時才需要手動設定。

# Next.js 伺服器端讀資料用（anon key，一律經過 RLS；不要放 service role key）
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# 瀏覽器連 Supabase 的網址（Google 登入的授權頁）。跟 SUPABASE_URL 相同時不用設定；只有 Docker（compose.yaml）需要。
# SUPABASE_PUBLIC_URL=

# pnpm seed 寫入的資料庫（不是 localhost 時還要加 --allow-remote）。腳本不會讀 .env 檔，請在執行前設定。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 網站的正式網址（canonical、sitemap、JSON-LD 用）。本機預設 http://localhost:3000，上線時一定要設定。
SITE_URL=http://localhost:3000

# 清快取 API（/api/revalidate）的密鑰。本機由 pnpm env:local 自動產生；正式環境見 docs/operations.md。
# pnpm seed／pnpm city 操作本機資料庫時，會讀 .env.local 的 SITE_URL 與這個密鑰通知本機網站。
REVALIDATE_SECRET=

# 選填：Google OAuth 用戶端 ID。設定後用 Google 官方登入按鈕，Google 的畫面顯示網站網址（decisions D28）；
# 沒設定時經過 Supabase 轉址。Google Cloud 的「已授權的 JavaScript 來源」要加上網站網址。
# GOOGLE_CLIENT_ID=
