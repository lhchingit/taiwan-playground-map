# 本機開發：執行 pnpm env:local，會從 supabase status 自動產生 .env.local（Next.js 會自動讀取）。
# 只有要連其他資料庫時才需要手動設定。

# Next.js 伺服器端讀資料用（anon key，一律經過 RLS；不要放 service role key）
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# pnpm seed 寫入的資料庫（不是 localhost 時還要加 --allow-remote）。腳本不會讀 .env 檔，請在執行前設定。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
