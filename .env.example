# 本機開發不需要設定：pnpm seed 預設連本機 Supabase，資料庫測試會讀 supabase status。
# 只有要連其他資料庫時，才在執行前設定這些環境變數（腳本不會自動讀 .env 檔）。

# pnpm seed 寫入的資料庫（不是 localhost 時還要加 --allow-remote）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 資料庫測試用（DATABASE_URL 加上這兩個，三個都設定時才會取代 supabase status 的值）
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
