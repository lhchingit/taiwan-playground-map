{
  "name": "playmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/screenshots.ts",
    "seed": "tsx scripts/seed.ts",
    "typegen": "supabase gen types typescript --local --schema public > src/types/database.ts",
    "env:local": "node scripts/write-env-local.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.13.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "8.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@supabase/supabase-js": "2.117.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "postgres": "3.4.9",
    "prettier": "3.9.9",
    "supabase": "2.120.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
